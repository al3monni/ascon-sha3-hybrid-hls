# ============================================================================
#  ascon-sha3-hybrid-hls - .gitignore
#  Repo root = Vitis Unified workspace (Vitis-HLS_Components)
#  Tracked per HLS component: sources, hls_config.cfg, vitis-comp.json.
#  Reference HLS results come from the Tcl flow (scripts/hls/) and are
#  archived in results/hls/<design>/ by collect.tcl.
# ============================================================================

# --- Vitis IDE workspace metadata (machine-specific) -----------------------
_ide/
**/_ide/
.vitisWorkspace.json
*.lock

# --- Tool caches / temp ------------------------------------------------------
.Xil/
.cache/
compile_commands.json
dfx_runtime.txt

# --- HLS work_dir of the IDE components: all output, regenerable ------------
#     [WAS] only */*/hls/ and */*/logs/ ignored: reports, summaries and the
#           packaged IP of the GUI flow were tracked next to the Tcl results
#     [OPT] the GUI is for inspection only; reference results = results/hls/
/*-Test/*-Test/

# --- Tcl flow: build tree (build/hls/<design>/...) and vitis-run logs --------
/logs/

# --- Vivado (future vivado/ folder: track only .tcl, .xdc, exported .xsa/.bit)
*.jou
*.str
*.log
*.cache/
*.runs/
*.sim/
*.gen/
*.ip_user_files/
*.hw/

# --- Compiled objects / binaries ---------------------------------------------
*.o
*.d
*.exe
*.out
/build/
/export/

# --- Vitis IDE report database (binary, regenerable) ---
**/reports/.db/

# --- Software benchmark: compiled binaries and temporary files ---
benchmarks/**/build/
benchmarks/**/results/**/.*
